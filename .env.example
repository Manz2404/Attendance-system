# Use the connection details from SQLyog. SQLyog itself is a client, not the server.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD="your_mysql_password"
DB_NAME=attendance_system
# Optional verified TLS for a remote MySQL server. Keep false for local MySQL.
DB_SSL=false
# Path to the server's CA certificate, if DB_SSL=true and a custom CA is needed.
DB_SSL_CA=
# The Windows scripts use port 3000 by default.
PORT=3000
# Local HTTP needs false. Set true only if serving the app through HTTPS.
COOKIE_SECURE=false

# Setup generates this private key automatically. Keep it with your database backups.
FACE_ENCRYPTION_KEY=
