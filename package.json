{
  "name": "hadir-attendance",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "next build --webpack",
    "start": "node scripts/serve.mjs start",
    "setup": "node scripts/setup.mjs",
    "db:check": "node scripts/check-db.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "admin:create": "node scripts/admin.mjs",
    "admin:reset-password": "node scripts/admin.mjs --reset",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/attendance.test.mjs tests/security.test.mjs",
    "test:mysql": "node --experimental-strip-types --test tests/mysql.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "mysql2": "3.24.5",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
